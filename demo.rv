// Build and run: raven build demo.rv -o demo && ./demo
import std/io { println }
import std/string
import "./lib" { parse }

fun main() {
    let text = "; app config\n[server]\nhost = 0.0.0.0\nport = 8080\n\n[db]\nname = appdb\nuser = raven\n"
    match parse(text) {
        Ok(cfg) -> {
            println("server: ".concat(cfg.get_or("server", "host", "")).concat(":").concat(cfg.get_or("server", "port", "")))
            println("db:     ".concat(cfg.get_or("db", "name", "")).concat(" as ").concat(cfg.get_or("db", "user", "")))
            println("sections: ".concat(cfg.sections().len().to_string()))
        },
        Err(e) -> println(e.to_string()),
    }
}
